# Copia este ficheiro para .env e ajusta os valores conforme precisares.
# Nenhum valor aqui é um segredo real (regra de segurança: .env.example nunca tem segredos reais).
# Usado pelo docker-compose.yml; todos têm um valor por omissão no próprio ficheiro,
# por isso "docker compose up" funciona mesmo sem copiar este ficheiro.

# --- Base de dados (MySQL 8.4, ADR-0007) ---
DB_DATABASE=kai
DB_USERNAME=kai
DB_PASSWORD=kai
DB_ROOT_PASSWORD=changeme_root

# --- Identity & Access (SPEC-002): apps/web autentica-se por sessão/cookie ---
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# --- Fornecedor de LLM (ADR-0006, D-08): lido pelo AI Engine (M03 E3.3) ---
# fake: determinístico, sem rede nem chaves — por omissão, para quem clona o repositório (P-015)
# anthropic: cloud, exige ANTHROPIC_API_KEY (falha no arranque sem ela)
# ollama: local, exige OLLAMA_HOST e OLLAMA_MODEL
# O fornecedor e o modelo vêm só daqui, nunca das mensagens (SPEC-004).
MODEL_PROVIDER=fake
ANTHROPIC_API_KEY=
# Vazio: claude-opus-5-5. Tem de estar na tabela de preços do AI Engine.
ANTHROPIC_MODEL=
# low | medium | high | xhigh | max (vazio: medium)
ANTHROPIC_EFFORT=
# Fallback de recusa do lado do servidor (lista com vírgulas). Vazio: claude-opus-5 para o
# Opus 5.5; "none" desliga. Todos os modelos têm de estar na tabela de preços.
ANTHROPIC_FALLBACK_MODELS=
# Dentro do contentor, o Ollama do host (Docker Desktop) está em host.docker.internal.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=

# --- Streaming de tokens: Reverb (ADR-0015, M03) ---
# O api publica por HTTP no serviço reverb; o browser liga-se a ws://localhost:8080.
# Valores fictícios: noutro ambiente, gera uma chave e um segredo aleatórios.
REVERB_APP_ID=kai-local
REVERB_APP_KEY=kai-local-key
REVERB_APP_SECRET=changeme-local-reverb

# --- RabbitMQ (ADR-0003, ADR-0016, M03) ---
# Um utilizador por serviço; topologia em infra/rabbitmq/. Sem valores por
# omissão: o RabbitMQ recusa arrancar com passwords vazias, de exemplo ou com
# menos de 24 caracteres. Gera-as com scripts/dev/passwords.sh.
KAI_RABBITMQ_ADMIN_PASSWORD=
KAI_RABBITMQ_API_PASSWORD=
KAI_RABBITMQ_AI_ENGINE_PASSWORD=

# --- Inbox do AI Engine (M03 E3.4a, P-020; profile messaging) ---
# Redis próprio do ai-engine, numa rede interna. Sem valor por omissão: o Redis
# e o ai-engine recusam arrancar sem ela. Gera com scripts/dev/passwords.sh.
KAI_AI_ENGINE_REDIS_PASSWORD=

# --- Observabilidade: grafana/otel-lgtm (ADR-0017, M03; profile observability) ---
# Password do admin do Grafana (o acesso anónimo está desligado). Sem valor por
# omissão: o contentor recusa arrancar sem ela. Gera com scripts/dev/passwords.sh.
KAI_GRAFANA_ADMIN_PASSWORD=
