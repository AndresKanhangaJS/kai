{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kai.internal/schemas/ai.model.usage.recorded.v1.json",
  "title": "ai.model.usage.recorded.v1",
  "description": "Evento (Python → Laravel, kai.events): consumo de uma chamada ao LLM, para model_usage e custos (ADR-0006). Uma mensagem por chamada. Idempotência: usage:{usage_id}.",
  "allOf": [
    {
      "$ref": "envelope.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "ai.model.usage.recorded.v1"
    },
    "producer": {
      "const": "kai-ai-engine"
    },
    "idempotency_key": {
      "pattern": "^usage:[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "usage_id",
        "provider",
        "model",
        "input_tokens",
        "output_tokens",
        "cost_usd",
        "latency_ms"
      ],
      "properties": {
        "user_id": {
          "$ref": "common.v1.json#/$defs/user_id"
        },
        "usage_id": {
          "$ref": "common.v1.json#/$defs/uuid"
        },
        "conversation_id": {
          "$ref": "common.v1.json#/$defs/uuid"
        },
        "run_id": {
          "$ref": "common.v1.json#/$defs/uuid"
        },
        "mission_id": {
          "$ref": "common.v1.json#/$defs/uuid"
        },
        "provider": {
          "type": "string",
          "enum": [
            "anthropic",
            "ollama",
            "fake"
          ]
        },
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "maxLength": 128
        },
        "input_tokens": {
          "$ref": "common.v1.json#/$defs/count"
        },
        "output_tokens": {
          "$ref": "common.v1.json#/$defs/count"
        },
        "cache_read_tokens": {
          "$ref": "common.v1.json#/$defs/count"
        },
        "cache_write_tokens": {
          "$ref": "common.v1.json#/$defs/count"
        },
        "cost_usd": {
          "$ref": "common.v1.json#/$defs/decimal_usd"
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        }
      },
      "anyOf": [
        {
          "required": [
            "conversation_id"
          ]
        },
        {
          "required": [
            "mission_id"
          ]
        }
      ]
    }
  }
}
