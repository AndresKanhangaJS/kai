{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kai.internal/schemas/ai.conversation.turn.requested.v1.json",
  "title": "ai.conversation.turn.requested.v1",
  "description": "Comando (Laravel → Python, kai.commands): gerar a resposta a uma mensagem do owner. Leva a janela de contexto, porque o Python não lê a BD do Laravel (SPEC-003 §2.1). O conteúdo nunca vai para logs nem spans. Idempotência: turn:{user_message_id}.",
  "allOf": [
    {
      "$ref": "envelope.v1.json"
    }
  ],
  "properties": {
    "type": {
      "const": "ai.conversation.turn.requested.v1"
    },
    "producer": {
      "const": "kai-api"
    },
    "idempotency_key": {
      "pattern": "^turn:[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "conversation_id",
        "user_message_id",
        "run_id",
        "messages",
        "limits"
      ],
      "properties": {
        "user_id": {
          "$ref": "common.v1.json#/$defs/user_id"
        },
        "conversation_id": {
          "$ref": "common.v1.json#/$defs/uuid"
        },
        "user_message_id": {
          "description": "A mensagem do owner a que se responde; é a última de messages.",
          "$ref": "common.v1.json#/$defs/uuid"
        },
        "run_id": {
          "description": "Canal privado do Reverb (run.{run_id}) para os deltas de streaming (ADR-0009).",
          "$ref": "common.v1.json#/$defs/uuid"
        },
        "mission_id": {
          "description": "Opcional: missão associada ao turno (M05).",
          "$ref": "common.v1.json#/$defs/uuid"
        },
        "messages": {
          "description": "Janela de contexto, por ordem cronológica. O tecto do contrato não é a política (SPEC-003 §6).",
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "message_id",
              "role",
              "content"
            ],
            "properties": {
              "message_id": {
                "$ref": "common.v1.json#/$defs/uuid"
              },
              "role": {
                "type": "string",
                "enum": [
                  "user",
                  "assistant"
                ]
              },
              "content": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32000
              }
            }
          }
        },
        "limits": {
          "description": "Orçamento e timeout do turno (NFR-011). Ao atingi-los, o Python emite turn.failed.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_output_tokens",
            "timeout_seconds",
            "max_cost_usd"
          ],
          "properties": {
            "max_output_tokens": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64000
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            },
            "max_cost_usd": {
              "$ref": "common.v1.json#/$defs/decimal_usd"
            }
          }
        },
        "tools": {
          "description": "Ferramentas expostas ao LLM neste turno (allowlist do Registry; nunca nível 6). Vazio ou ausente: nenhuma.",
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "common.v1.json#/$defs/tool_ref"
          }
        }
      }
    }
  }
}
