{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kai.internal/schemas/common.v1.json",
  "title": "Definições comuns v1",
  "description": "Tipos partilhados pelos contratos v1 (SPEC-003). Não é uma mensagem.",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "uuidv7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "user_id": {
      "description": "Dono dos dados (users.id), obrigatório em todos os payloads (NFR-009). Nos eventos Python → Laravel serve só para lookup: o Laravel deriva o dono do seu próprio registo (conversa, run, missão, passo) e rejeita para a DLQ, com auditoria, qualquer divergência (SPEC-003 §4).",
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "description": "RFC 3339 em UTC, com segundos e o sufixo Z. A pattern é normativa (não depende de format).",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]{1,9})?Z$",
      "maxLength": 40
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tool_ref": {
      "description": "Ferramenta do Tool Registry, com versão. O nível e o modo nunca vão aqui (ADR-0013).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "maxLength": 100
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "maxLength": 32
        }
      }
    },
    "tool_arguments": {
      "description": "Argumentos de uma chamada de ferramenta, propostos pelo LLM: não confiáveis. Limitados em tamanho e profundidade (≤ 4). O Laravel valida-os contra o schema da ferramenta no Registry.",
      "type": "object",
      "maxProperties": 50,
      "propertyNames": {
        "maxLength": 100
      },
      "additionalProperties": {
        "$ref": "#/$defs/json_value_d3"
      }
    },
    "safe_error": {
      "description": "Erro seguro: um código estável e uma mensagem sem dados sensíveis nem stack trace.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 64
        },
        "message": {
          "type": "string",
          "maxLength": 500
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "decimal_usd": {
      "description": "Valor em USD como string decimal (até 8 casas), para evitar vírgula flutuante.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,8})(\\.[0-9]{1,8})?$"
    },
    "json_leaf": {
      "description": "Valor escalar limitado.",
      "anyOf": [
        {
          "type": "string",
          "maxLength": 8000
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "number",
          "minimum": -1000000000000000.0,
          "maximum": 1000000000000000.0
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "json_value_d1": {
      "description": "Valor JSON limitado, com profundidade ≤ 1.",
      "anyOf": [
        {
          "$ref": "#/$defs/json_leaf"
        },
        {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/json_leaf"
          }
        },
        {
          "type": "object",
          "maxProperties": 50,
          "propertyNames": {
            "maxLength": 100
          },
          "additionalProperties": {
            "$ref": "#/$defs/json_leaf"
          }
        }
      ]
    },
    "json_value_d2": {
      "description": "Valor JSON limitado, com profundidade ≤ 2.",
      "anyOf": [
        {
          "$ref": "#/$defs/json_leaf"
        },
        {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/json_value_d1"
          }
        },
        {
          "type": "object",
          "maxProperties": 50,
          "propertyNames": {
            "maxLength": 100
          },
          "additionalProperties": {
            "$ref": "#/$defs/json_value_d1"
          }
        }
      ]
    },
    "json_value_d3": {
      "description": "Valor JSON limitado, com profundidade ≤ 3.",
      "anyOf": [
        {
          "$ref": "#/$defs/json_leaf"
        },
        {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/json_value_d2"
          }
        },
        {
          "type": "object",
          "maxProperties": 50,
          "propertyNames": {
            "maxLength": 100
          },
          "additionalProperties": {
            "$ref": "#/$defs/json_value_d2"
          }
        }
      ]
    },
    "tool_output": {
      "description": "Resultado de uma ferramenta: conteúdo externo, não confiável. Limitado em tamanho e profundidade (≤ 4). Nunca leva o grant nem credenciais.",
      "type": "object",
      "maxProperties": 50,
      "propertyNames": {
        "maxLength": 100
      },
      "additionalProperties": {
        "$ref": "#/$defs/json_value_d3"
      }
    },
    "traceparent": {
      "description": "W3C Trace Context (versão 00), sem IDs a zero.",
      "type": "string",
      "pattern": "^00-(?!0{32})[0-9a-f]{32}-(?!0{16})[0-9a-f]{16}-[0-9a-f]{2}$"
    },
    "tracestate": {
      "description": "W3C tracestate: só ASCII imprimível (sem CR/LF nem controlo).",
      "type": "string",
      "pattern": "^[\\x20-\\x7e]*$",
      "maxLength": 512
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    }
  }
}
